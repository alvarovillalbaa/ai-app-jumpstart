# Copy to .env.local. Never commit live credentials.
# Required at runtime in production: the exact public HTTPS origin.
# Loopback HTTP is allowed for local access; public origins require HTTPS.
APP_ORIGIN=http://localhost:3000
# For a split Next/Eve production deployment, set this at BUILD time to Eve's
# private origin so Next does not start a local Eve process. Public /eve and
# Workflow traffic must bypass Next at the streaming ingress; see docs/hosting.md.
# EVE_NEXT_PRODUCTION_ORIGIN=http://eve.internal:4274
# In a private container network with a separate ingress, make the co-located
# Eve listener reachable to that ingress; never publish its port directly.
# EVE_LISTEN_HOST=0.0.0.0
DATA_PROVIDER=sqlite
SQLITE_PATH=.data/app.sqlite

# Generate a credential with npm run auth:key -- local developer write.
# Paste ONLY its configuration array below. Keep the token for your client.
APP_API_KEYS=[]

# Optional browser accounts, independent of DATA_PROVIDER. No service keys here.
AUTH_PROVIDER=api-key
# AUTH_PROVIDER=supabase
# SUPABASE_AUTH_URL=https://project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Configure APP_ORIGIN and Supabase's Site URL / redirect allowlist for this host.

# postgres: any compatible PostgreSQL provider, including Supabase pooler.
# Use the provider's verified TLS connection string. Never disable verification.
# DATABASE_URL=postgresql://user:password@localhost:5432/app

# supabase: server-only PostgREST access. Run migrations via DATABASE_URL first.
# SUPABASE_URL=https://project.supabase.co
# Backend keys are refused at non-loopback HTTP origins.
# SUPABASE_SECRET_KEY=

# Optional private upload quarantine. Explicitly select a persistent object store.
# The authenticated HTTP/CLI upload path accepts up to 4 MiB per file; the
# metadata quota is 20 files / 50 MiB per owner. Files stay quarantined.
# Owner downloads require the self-hosted scan-on-read policy below; agent
# attachments remain unavailable.
# For self-hosted Node/containers, mount a private persistent volume:
# UPLOAD_STORAGE_PROVIDER=local
# UPLOAD_LOCAL_ROOT=/var/lib/jumpstart/uploads
# For Vercel + Supabase, apply migrations and provision the private bucket first:
# UPLOAD_STORAGE_PROVIDER=supabase
# This reuses SUPABASE_URL and SUPABASE_SECRET_KEY above.
# Optional self-hosted scan-before-storage, using a private ClamAV Unix socket:
# UPLOAD_SCANNER_PROVIDER=clamd
# UPLOAD_CLAMD_SOCKET=/run/clamav/clamd.sock
# Self-hosted only: re-scan every owner download; requires the private clamd socket above.
# UPLOAD_DOWNLOAD_POLICY=scan-on-read
# Check its live signatures with npm run check:upload-scanner.
# Required for the daily Vercel Cron cleanup route, including records-only deployments.
# Other schedulers can use the same protected route. Use at least 32 random
# characters; keep it server-only and never commit it.
# CRON_SECRET=
# API keys need uploads:read/write for metadata and writes; uploads:download is separate. Registered users
# receive both upload scopes. Never prefix storage secrets with NEXT_PUBLIC_.

# convex: deploy convex/ first; use the HTTP-actions origin (.convex.site).
# Set this backend-only secret in BOTH the Next server and the Convex deployment.
# It is a database credential, not an APP_API_TOKEN. Minimum 32 random characters.
# CONVEX_SITE_URL=https://project.convex.site
# CONVEX_BACKEND_SECRET=

# CLI client. The token is not a database or Supabase secret.
# APP_API_URL=http://localhost:3000
# APP_API_TOKEN=

# Eve model credential (local/self-hosted).
# AI_GATEWAY_API_KEY=
# EVE_NEXT_PRODUCTION_ORIGIN=https://agent.example.com

# Required for account-owned Eve execution once public chat is enabled.
# Server-only JSON: policy, estimateMicros, maxModelCalls, modelIds and costBasis.
# Enabled account chat requires an attributed costBasis with one model quote per ID;
# see docs/usage-budgets.md. No vendor price or token cap is assumed.
# AI_BUDGET_POLICY_JSON=

# Opt-in account chat. Set these on BOTH Next and Eve, with the same DATA_PROVIDER.
# Requires AUTH_PROVIDER=supabase and a reviewed AI_BUDGET_POLICY_JSON above.
AI_CHAT_ENABLED=false
# AI_RUNTIME_ORIGIN=http://127.0.0.1:4274
# AI_CREATION_SIGNING_JSON={"audience":"your-app:environment","activeKey":"v1","keys":{"v1":"64-lowercase-hex-characters-from-32-random-bytes"}}
# Generate signing material locally; never prefix these settings with NEXT_PUBLIC_.
# See docs/account-chat.md for origin routing, key rotation, and current limitations.

# Workflow storage is independent of DATA_PROVIDER. This selector is BUILD-TIME.
# Default selects local workflows on Node, or managed Workflow on Vercel.
# For long-running cloud containers, build with EVE_WORKFLOW_PROVIDER=postgres.
# EVE_WORKFLOW_PROVIDER=postgres
# At runtime, require the matching compiled world. Cloud examples set this.
# WORKFLOW_EXPECTED_PROVIDER=postgres
# Required at runtime and for npm run workflow:migrate in PostgreSQL mode:
# WORKFLOW_POSTGRES_URL=postgresql://workflow:password@host:5432/workflow
# WORKFLOW_POSTGRES_JOB_PREFIX=your_app_staging
# WORKFLOW_POSTGRES_WORKER_CONCURRENCY=5
# WORKFLOW_POSTGRES_MAX_POOL_SIZE=10
# Use a direct/session connection, verified TLS and a private workflow database.
