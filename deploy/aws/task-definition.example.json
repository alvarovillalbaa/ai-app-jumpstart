{
  "family": "jumpstart-staging",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "REPLACE_WITH_EXECUTION_ROLE_ARN",
  "taskRoleArn": "REPLACE_WITH_TASK_ROLE_ARN",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "containerDefinitions": [{
    "name": "app",
    "image": "REPLACE_WITH_POSTGRES_WORKFLOW_IMAGE_AT_SHA256_DIGEST",
    "essential": true,
    "user": "1000:1000",
    "stopTimeout": 30,
    "environment": [
      { "name": "APP_ORIGIN", "value": "https://REPLACE_WITH_APP_DOMAIN" },
      { "name": "DATA_PROVIDER", "value": "supabase" },
      { "name": "AUTH_PROVIDER", "value": "supabase" },
      { "name": "AI_CHAT_ENABLED", "value": "true" },
      { "name": "APP_AGENT_READINESS", "value": "local" },
      { "name": "AI_RUNTIME_ORIGIN", "value": "http://127.0.0.1:4274" },
      { "name": "WORKFLOW_EXPECTED_PROVIDER", "value": "postgres" },
      { "name": "WORKFLOW_POSTGRES_JOB_PREFIX", "value": "jumpstart_staging" }
    ],
    "secrets": [
      { "name": "WORKFLOW_POSTGRES_URL", "valueFrom": "REPLACE_WITH_WORKFLOW_DATABASE_SECRET_ARN" },
      { "name": "SUPABASE_URL", "valueFrom": "REPLACE_WITH_DATA_URL_SECRET_ARN" },
      { "name": "SUPABASE_SECRET_KEY", "valueFrom": "REPLACE_WITH_DATA_KEY_SECRET_ARN" },
      { "name": "SUPABASE_AUTH_URL", "valueFrom": "REPLACE_WITH_AUTH_URL_SECRET_ARN" },
      { "name": "SUPABASE_PUBLISHABLE_KEY", "valueFrom": "REPLACE_WITH_AUTH_PUBLIC_KEY_SECRET_ARN" },
      { "name": "AI_CREATION_SIGNING_JSON", "valueFrom": "REPLACE_WITH_SIGNING_SECRET_ARN" },
      { "name": "AI_BUDGET_POLICY_JSON", "valueFrom": "REPLACE_WITH_BUDGET_POLICY_SECRET_ARN" },
      { "name": "AI_GATEWAY_API_KEY", "valueFrom": "REPLACE_WITH_MODEL_SECRET_ARN" }
    ],
    "healthCheck": {
      "command": ["CMD", "node", "-e", "fetch('http://127.0.0.1:3000/api/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"],
      "interval": 30, "timeout": 5, "retries": 3, "startPeriod": 60
    },
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": { "awslogs-group": "REPLACE_WITH_LOG_GROUP", "awslogs-region": "REPLACE_WITH_REGION", "awslogs-stream-prefix": "app" }
    }
  }, {
    "name": "ingress",
    "image": "REPLACE_WITH_INGRESS_IMAGE_AT_SHA256_DIGEST",
    "essential": true,
    "user": "1000:1000",
    "stopTimeout": 30,
    "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
    "dependsOn": [{ "containerName": "app", "condition": "HEALTHY" }],
    "environment": [
      { "name": "NEXT_UPSTREAM", "value": "127.0.0.1:3000" },
      { "name": "EVE_UPSTREAM", "value": "127.0.0.1:4274" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": { "awslogs-group": "REPLACE_WITH_LOG_GROUP", "awslogs-region": "REPLACE_WITH_REGION", "awslogs-stream-prefix": "ingress" }
    }
  }]
}
