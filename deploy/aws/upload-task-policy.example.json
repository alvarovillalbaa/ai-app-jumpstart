{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectPrivateUploadBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketVersioning",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::REPLACE_PRIVATE_UPLOAD_BUCKET"
    },
    {
      "Sid": "ReadWritePrivateUploadObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_PRIVATE_UPLOAD_BUCKET/uploads/v1/*"
    }
  ]
}
