{
  "name": "ai-app-jumpstart",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./agent/*"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-local.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "dev:eve": "eve dev",
    "build:eve": "eve build",
    "start:eve": "eve start",
    "eval": "eve eval",
    "deploy": "eve deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "vitest run tests/backend",
    "test:frontend": "vitest run tests/frontend",
    "app": "tsx --env-file-if-exists=.env.local scripts/app-cli.ts",
    "seed:records": "tsx --env-file-if-exists=.env.local scripts/app-cli.ts seed",
    "auth:key": "tsx scripts/create-api-key.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:local:start": "supabase start --exclude realtime,storage-api,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:local:status": "supabase status",
    "db:local:stop": "supabase stop",
    "db:types": "node scripts/generate-supabase-types.mjs",
    "db:types:check": "node scripts/generate-supabase-types.mjs --check",
    "db:types:check:ci": "node scripts/generate-supabase-types.mjs --check --local-db-url",
    "workflow:migrate": "node scripts/migrate-workflow.mjs",
    "workflow:recover": "node --env-file-if-exists=.env.local scripts/recover-workflow.mjs",
    "starts:inspect": "tsx --env-file-if-exists=.env.local scripts/inspect-starts.ts",
    "budgets:reconcile": "tsx --env-file-if-exists=.env.local scripts/reconcile-budget.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:ai": "node scripts/eval-offline.mjs",
    "test:session-runtime": "tsx scripts/test-session-runtime.ts",
    "test:workflow-postgres": "tsx scripts/test-session-runtime.ts --postgres-workflows",
    "test:workflow-compose": "node scripts/test-workflow-compose.mjs",
    "eval:live": "eve eval --strict",
    "build:local": "npm run build:eve && node scripts/workflow-build-policy.mjs --write && npm run build",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:supabase": "node scripts/test-postgres.mjs --supabase",
    "test:convex": "node scripts/test-convex.mjs",
    "test:providers": "npm run test:postgres && npm run test:supabase && npm run test:convex",
    "test:container": "node scripts/test-container.mjs",
    "test:vercel-build": "node scripts/test-vercel-build.mjs",
    "check:managed-config": "tsx --env-file-if-exists=.env.local scripts/check-managed-config.ts",
    "check:budget-policy": "tsx --env-file-if-exists=.env.local scripts/check-budget-policy.ts",
    "smoke:hosted": "node scripts/smoke-hosted.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:chat": "node scripts/test-auth.mjs --chat",
    "test:chat:container": "node scripts/test-auth.mjs --chat --container",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen --typecheck enable"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "5.9.1",
    "@jumpstart/workflow-postgres": "file:packages/workflow-postgres",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@rive-app/react-webgl2": "^4.34.2",
    "@shadcn/react": "^0.3.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@vercel/connect": "^2.1.0",
    "@workflow/world-postgres": "5.0.0-beta.42",
    "@xyflow/react": "^12.11.6",
    "ai": "7.0.99",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "convex": "1.46.0",
    "cuelume": "0.2.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "eve": "0.54.5",
    "input-otp": "^1.5.0",
    "jose": "6.2.12",
    "just-bash": "^3.4.2",
    "lucide-react": "1.46.0",
    "media-chrome": "^4.19.2",
    "motion": "^13.3.0",
    "nanoid": "^6.0.1",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "react-jsx-parser": "^2.4.1",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.8.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "sonner": "2.0.8",
    "streamdown": "^2.6.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "0.0.59",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.1.1",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.1"
  },
  "overrides": {
    "ansi-to-react": {
      "linkify-it": "5.0.2"
    }
  }
}
